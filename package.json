{
  "type": "module",
  "name": "@signpostmarv/json-schema-typescript-codegen",
  "description": "JSON Schema TypeScript CodeGen",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SignpostMarv/JSON-Schema-TypeScript-CodeGen.git"
  },
  "funding": "https://github.com/SignpostMarv/JSON-Schema-TypeScript-CodeGen?sponsor=1",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./ajv": {
      "types": "./src/Ajv/index.d.ts",
      "default": "./src/Ajv/index.js"
    },
    "./typescript-overrides": {
      "types": "./src/typescript/index.d.ts",
      "default": "./src/typescript/index.js"
    }
  },
  "engines": {
    "node": "^26.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "devDependencies": {
    "@satisfactory-dev/custom-assert": "^0.5.0",
    "@signpostmarv/oxlint-config": "^0.4.0",
    "@signpostmarv/ts-assert": "^0.7.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.2",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.8.2"
  },
  "peerDependencies": {
    "@satisfactory-dev/predicates.ts": "^0.3.0",
    "@signpostmarv/js-types": "^0.5.0",
    "@signpostmarv/ts-assert": "^0.7.0",
    "@typescript/typescript6": "^6.0.2",
    "ajv": "^8.20.0"
  }
}
